# Real Scrutora CMP credentials -- copy this file to .env and fill in real
# values from the Scrutora dashboard. Never commit the filled-in .env.
# docker-compose.yml reads these automatically if .env exists.

# Bearer token for server-to-server calls (state query, DSR creation).
SCRUTORA_API_KEY=

# From the Scrutora dashboard: identifies this site/property.
SCRUTORA_SITE_ID=
SCRUTORA_SITE_KEY=

# Used to verify the X-Scrutora-Signature-256 header on incoming webhooks.
SCRUTORA_WEBHOOK_SECRET=
