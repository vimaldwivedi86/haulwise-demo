FROM node:20-slim

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000
ARG NEXT_PUBLIC_SCRUTORA_SITE_KEY=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_SCRUTORA_SITE_KEY=$NEXT_PUBLIC_SCRUTORA_SITE_KEY

COPY package.json ./
RUN npm install

COPY . .

RUN npm run build

CMD ["npm", "start"]
